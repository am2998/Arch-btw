[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = linux-lts
Target = zfs-dkms
Target = zfs-utils
Target = dracut
Target = systemd

[Action]
Description = Rebuild ZFS initramfs + UKI and re-sign the boot chain (ZFS)
When = PostTransaction
Exec = /usr/local/bin/zfs-dracut-kernel-refresh
NeedsTargets
